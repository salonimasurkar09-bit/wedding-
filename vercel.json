{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "devCommand": "npm run dev",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/handler.js": {
      "runtime": "nodejs18.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/placeholder.png",
      "dest": "/placeholder.png"
    },
    {
      "src": "/c1.png",
      "dest": "/c1.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/handler"
    }
  ]
}

